# Keep real project/source files visible to Git:
# - android/ and ios/ are NOT ignored
# - modules/**/android and modules/**/ios are NOT ignored
# - .txt, .md, .ps1, .cjs are NOT globally ignored

# Local/generated folders - never commit
.vscode/
android/
ios/
backend/
public/
docs/
tools/
scripts/
patches/

# Local repair/build scripts - never commit
build-android-apk.ps1
install-sabi-emblem.ps1

