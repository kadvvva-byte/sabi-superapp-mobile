{
  "expo": {
    "name": "superapp-mobile",
    "slug": "superapp-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "superappmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_PHONE_STATE",
        "android.permission.CALL_PHONE",
        "android.permission.BIND_TELECOM_CONNECTION_SERVICE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.anonymous.superappmobile",
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Р Р°Р·СЂРµС€РёС‚Рµ Sabi РёСЃРїРѕР»СЊР·РѕРІР°С‚СЊ Face ID РґР»СЏ РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ РїР»Р°С‚РµР¶РµР№ Рё РїРµСЂРµРІРѕРґРѕРІ."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Р Р°Р·СЂРµС€РёС‚Рµ Sabi РёСЃРїРѕР»СЊР·РѕРІР°С‚СЊ РјРёРєСЂРѕС„РѕРЅ РґР»СЏ Р°СѓРґРёРѕР·РІРѕРЅРєРѕРІ.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Р Р°Р·СЂРµС€РёС‚Рµ Sabi РёСЃРїРѕР»СЊР·РѕРІР°С‚СЊ РєР°РјРµСЂСѓ РґР»СЏ РІРёРґРµРѕР·РІРѕРЅРєРѕРІ.",
          "microphonePermission": "Р Р°Р·СЂРµС€РёС‚Рµ Sabi РёСЃРїРѕР»СЊР·РѕРІР°С‚СЊ РјРёРєСЂРѕС„РѕРЅ РґР»СЏ Р°СѓРґРёРѕР·РІРѕРЅРєРѕРІ."
        }
      ],
      [
        "@config-plugins/react-native-callkeep",
        {
          "ios": {
            "appName": "Sabi",
            "supportsVideo": false,
            "includesCallsInRecents": true,
            "maximumCallGroups": 1,
            "maximumCallsPerCallGroup": 1
          }
        }
      ],
      "./modules/sabi-screen-share/app.plugin.js",
      "./modules/sabi-video-call-picture-in-picture/app.plugin.js",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Разрешите Sabi использовать геолокацию для отправки локации в Messenger."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b42bed1-e971-4b94-8007-d6b18ac750ca"
      },
      "apiBaseUrl": "",
      "authApiBaseUrl": "",
      "qrApiBaseUrl": "",
      "socketBaseUrl": "",
      "socketPath": "/socket.io"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}
