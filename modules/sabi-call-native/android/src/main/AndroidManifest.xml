<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
  <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

  <application>
    <activity
      android:name="expo.modules.sabicallnative.SabiIncomingCallActivity"
      android:excludeFromRecents="true"
      android:exported="false"
      android:launchMode="singleTask"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:theme="@android:style/Theme.Material.NoActionBar" />

    <receiver
      android:name="expo.modules.sabicallnative.SabiCallActionReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="expo.modules.sabicallnative.ACCEPT" />
        <action android:name="expo.modules.sabicallnative.DECLINE" />
        <action android:name="expo.modules.sabicallnative.END" />
      </intent-filter>
    </receiver>

    <service
      android:name="expo.modules.sabicallnative.SabiCallForegroundService"
      android:exported="false"
      android:foregroundServiceType="phoneCall|microphone"
      android:stopWithTask="false" />

    <service
      android:name="expo.modules.sabicallnative.SabiFirebaseMessagingService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
